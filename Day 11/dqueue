import java.util.*;

public class dqueue{
    public static void main(String[] args) {
        Deque<Integer> d = new ArrayDeque<>();
            d.add(1);
            d.add(2);
            d.add(3);
            System.out.println(d);
            d.addFirst(0);
            System.out.println(d);
            d.addLast(4);
            System.out.println(d);
            d.removeFirst();
            System.out.println(d);
            d.removeLast();
            System.out.println(d);

    }
}